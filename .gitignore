# Virtual environments (also covers .venv-pandas2/)
.venv*/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
outputs/_run/

# Temporary files: unfinished downloads are written as *.part, then renamed when complete
*.part
*.tmp

# Large files (GitHub rejects anything over 100 MB): keep these in data/large/, never in data/raw/
data/large/

# OS files
.DS_Store
Thumbs.db
